+function streamedRequest(url: string, headers: HeadersInit, chunkSize: number) {
+  let pulls = 0;
+  let cancelled = false;
+  const body = new ReadableStream<Uint8Array>({
+    pull(controller) {
+      if (pulls === 8) { controller.close(); return; }
+      pulls++;
+      controller.enqueue(new Uint8Array(chunkSize).fill(120));
+    },
+    cancel() { cancelled = true; },
+  });
+  return {
+    request: new Request(url, { method: "POST", headers, body, duplex: "half" } as RequestInit),
+    get cancelled() { return cancelled; },
+    get pulls() { return pulls; },
+  };
+}
+
+test("checkout cancels an oversized streamed body without Content-Length before buffering the rest", async () => {
+  const mock = fixture();
+  const streamed = streamedRequest(`${origin}/api/checkout`, request().headers, 1024);
+  assert.equal((await createCheckout(streamed.request, () => mock.stripe)).status, 413);
+  assert.equal(streamed.cancelled, true);
+  assert.ok(streamed.pulls < 8);
+  assert.deepEqual(mock.calls, { createCalls: 0, retrieveCalls: 0 });
+});
+
